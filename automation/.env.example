# Gemini API Key (Free tier available at aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key

# Hugging Face Inference API (Free tier at huggingface.co/settings/tokens)
HUGGINGFACE_API_KEY=your_hugging_face_token

# Cloudinary (Free tier account at cloudinary.com)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Meta Instagram Graph API
# (Optional: leave blank to execute in Dry-Run mode)
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id
META_ACCESS_TOKEN=your_meta_system_user_or_page_access_token

# Optional WAHA WhatsApp Docker (Bonus Workflow)
WAHA_BASE_URL=http://localhost:3008
WAHA_SESSION=default
